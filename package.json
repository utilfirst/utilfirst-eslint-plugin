{
  "name": "@utilfirst/eslint-plugin",
  "version": "0.4.11",
  "description": "Shared lint rules for ESLint and Oxlint",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "homepage": "https://github.com/utilfirst/utilfirst-eslint-plugin#readme",
  "bugs": "https://github.com/utilfirst/utilfirst-eslint-plugin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/utilfirst/utilfirst-eslint-plugin.git"
  },
  "license": "MIT",
  "author": "Ayan Yenbekbay <ayan.yenb@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./dist/oxlint.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run lint && pnpm run test",
    "fix": "pnpm run --sequential '/^fix:[^:]+$/'",
    "fix:oxlint": "pnpm run lint:oxlint --fix",
    "fix:prettier": "pnpm run lint:prettier --write",
    "lint": "pnpm run build && pnpm run '/^lint:[^:]+$/'",
    "lint:oxlint": "oxlint .",
    "lint:prettier": "prettier --check .",
    "lint:publint": "publint",
    "prepack": "pnpm run build",
    "release-check-tag": "node scripts/check-release-tag.ts",
    "test": "pnpm run --sequential '/^test:[^:]+$/'",
    "test:package": "node scripts/test-package.ts",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@oxlint/plugins": "1.80.0",
    "@typescript-eslint/utils": "8.68.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/rule-tester": "8.68.0",
    "@utilfirst/prettier-plugin": "0.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "changelogithub": "15.0.5",
    "eslint": "10.9.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-sort-json": "4.2.0",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "oxlint": ">=1.78.0 <2"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
